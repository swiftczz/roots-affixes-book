      #d-down(mark: "↓")
      #d-node("直接派生大量拉丁词\nspectrum（景象）\nspectaculum（表演）\nspecies（外观→种类）\nspeculum（镜子）", kind: "node")
      #d-down(mark: "↓")
      #d-node("英语\nspect 词根家族\n（文艺复兴时期，大量整词进入英语）", kind: "node")
    ]
