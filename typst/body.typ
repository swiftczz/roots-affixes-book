    table.hline(),
    [\*p], [#strong[f]], [pater → father;pisces（鱼）→ fish],
    [\*t], [#strong[th]], [tres → three;tu（你）→ thou],
    [\*k], [#strong[h]], [kan-（唱）→ hen;cor（心）→ heart],
    [\*b], [#strong[p]], [---],
    [\*d], [#strong[t]], [dent-（齿）→ tooth],
    [\*g], [#strong[k]], [genus（种类）→ kin],
    [\*kw], [#strong[wh]], [kwis（谁）→ who],
  )
]

