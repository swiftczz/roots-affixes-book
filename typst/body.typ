    #f-diagram(spacing: (7mm, 4mm),
      fnode((0, 0), "ducere\n（动词：引导）", kind: "root", w: 26.2mm),
      fnode((1, 0), "dux\n（名词：领袖、统帅）", kind: "node", w: 35.1mm),
      fnode((2, 0), "威尼斯语 doge\n→ Doge（威尼斯总督）", kind: "node", w: 35.3mm),
